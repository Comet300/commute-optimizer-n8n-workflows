              "rightValue": "true",
              "operation": {
                "type": "string",
                "operation": "equals",
                "sameType": false
              }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "db6c82d3-63ee-462e-b1ff-eeb38915d468",
      "position": [
