    {
      "name": "Handle Geocode Failure",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "// Geocode failed — build a row without commute data.\n// The event still appears in daily_plan but with no departure time or travel info.\n// WF3 will send reminders based on start_time only (remind_60, remind_15).\nconst event = $('Classify Event').item.json;\nconst user = $('Loop Users').item.json;\nconst origin = $('Check If Travelling').item.json;\nconst start = new Date(event.adjusted_start);\n\nreturn { json: {\n  event_id: event.event_id,\n  user_id: user.user_id,\n  title: event.title,\n  start_time: event.adjusted_start,\n  end_time: event.adjusted_end,\n  location: event.location,\n  location_coords: '',\n  is_online: false,\n  is_tentative: event.is_tentative,\n  commute_mode: '',\n  departure_time: '',\n  commute_minutes: 0,\n  weather_worst: '',\n  clothing_advice: '',\n  remind_dressed: '',\n  remind_60: new Date(start.getTime() - 60 * 60 * 1000).toISOString(),\n  remind_30: '',\n  remind_15: new Date(start.getTime() - 15 * 60 * 1000).toISOString(),\n  remind_now: '',\n  plan_date: $now.toFormat('yyyy-MM-dd'),\n  origin_coords: origin.origin_coords,\n  origin_type: origin.origin_type,\n  ntfy_topic: user.ntfy_topic,\n  at_home: origin.origin_type === 'home',\n  current_state: 'planned',\n  state_version: 0,\n  _geocode_failed: true\n}};",
        "mode": "runOnceForAllItems"
      },
      "id": "c2bb1ae3-0ecc-44e3-9849-4fa953b060cc",
      "position": [
        470,
        1180
