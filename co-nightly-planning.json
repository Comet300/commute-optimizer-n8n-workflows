    {
      "name": "Calculate Online Reminders",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "// Online events only get T-60 and T-15 reminders.\n// at_home is set from origin_type (same as physical events). WF4 updates it via GPS.\nconst event = $json;\nconst user = $('Loop Users').item.json;\nconst origin = $('Check If Travelling').item.json;\nconst start = new Date(event.adjusted_start);\nconst remind60 = new Date(start.getTime() - 60 * 60 * 1000);\nconst remind15 = new Date(start.getTime() - 15 * 60 * 1000);\n\nreturn { json: {\n  event_id: event.event_id,\n  user_id: user.user_id,\n  title: event.title,\n  start_time: event.adjusted_start,\n  end_time: event.adjusted_end,\n  location: '',\n  location_coords: '',\n  is_online: true,\n  is_tentative: event.is_tentative,\n  commute_mode: 'none',\n  departure_time: '',\n  commute_minutes: 0,\n  weather_worst: '',\n  clothing_advice: '',\n  remind_dressed: '',\n  remind_60: remind60.toISOString(),\n  remind_30: '',\n  remind_15: remind15.toISOString(),\n  remind_now: '',\n  plan_date: $now.toFormat('yyyy-MM-dd'),\n  origin_coords: origin.origin_coords,\n  origin_type: origin.origin_type,\n  ntfy_topic: user.ntfy_topic,\n  at_home: origin.origin_type === 'home',\n  current_state: 'planned',\n  state_version: 0\n}};",
        "mode": "runOnceForAllItems"
      },
      "id": "874809a5-d007-4b1a-a3d8-3fd9ca89ebe3",
      "position": [
        910,
        960
      ]
