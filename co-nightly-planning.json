    {
      "name": "Check If Travelling",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "// Check if user's last known location is >5km from home\nconst user = $('Loop Users').item.json;\nconst allLocationRows = $input.all();\nconst homeLat = user.home_lat;\nconst homeLng = user.home_lng;\n\n// Filter to THIS user's locations only (Node 7a reads all users' rows)\nconst locationRows = allLocationRows.filter(r => r.json.user_id === user.user_id);\n\nlet origin_coords = `${homeLat},${homeLng}`;\nlet origin_type = 'home';\n\nif (locationRows.length > 0) {\n  const loc = locationRows[0].json;\n  const locTime = new Date(loc.timestamp);\n  const eightHoursAgo = new Date(Date.now() - 8 * 60 * 60 * 1000);\n\n  if (locTime > eightHoursAgo) {\n    // Calculate distance using Haversine formula\n    const R = 6371; // Earth radius in km\n    const dLat = (loc.latitude - homeLat) * Math.PI / 180;\n    const dLng = (loc.longitude - homeLng) * Math.PI / 180;\n    const a = Math.sin(dLat/2) * Math.sin(dLat/2) +\n              Math.cos(homeLat * Math.PI / 180) * Math.cos(loc.latitude * Math.PI / 180) *\n              Math.sin(dLng/2) * Math.sin(dLng/2);\n    const distance = R * 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1-a));\n\n    if (distance > 5) {\n      origin_coords = `${loc.latitude},${loc.longitude}`;\n      origin_type = 'travel';\n    }\n  }\n}\n\nreturn { json: { ...user, origin_coords, origin_type } };",
        "mode": "runOnceForAllItems"
      },
      "id": "0550bbbd-ce88-4325-aaea-18675e00009d",
      "position": [
        250,
        740
      ]
    },
