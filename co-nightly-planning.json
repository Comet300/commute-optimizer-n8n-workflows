    {
      "name": "Calculate Tracking Intervals",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "// For each user's earliest non-online event, calculate the initial GPS polling interval.\n// Users with no trackable events today get filtered out.\nconst rows = $input.all().map(i => i.json);\nconst now = $now; // Luxon DateTime, inherits GENERIC_TIMEZONE from n8n env config\n\n// Group by user_id, find earliest planned departure per user\nconst userMap = {};\nfor (const row of rows) {\n  if (row.is_online === 'TRUE' || row.is_online === true) continue;\n  if (['cancelled', 'skipped', 'expired'].includes(row.current_state)) continue;\n\n  const userId = row.user_id;\n  if (!userMap[userId]) {\n    userMap[userId] = row;\n  } else {\n    // Keep the earlier departure\n    const existing = DateTime.fromISO(userMap[userId].departure_time);\n    const candidate = DateTime.fromISO(row.departure_time);\n    if (candidate < existing) {\n      userMap[userId] = row;\n    }\n  }\n}\n\n// Parse tracking interval tiers from $vars (or use defaults)\nconst tierStr = $vars.TRACKING_INTERVAL_TIERS; // e.g. \"60:20,30:10,15:5,5:3\"\nlet tiers = [\n  { withinMin: 60, interval: 20 },\n  { withinMin: 30, interval: 10 },\n  { withinMin: 15, interval: 5 },\n  { withinMin: 5, interval: 3 }\n];\nif (tierStr) {\n  tiers = tierStr.split(',').map(pair => {\n    const [withinMin, interval] = pair.split(':').map(Number);\n    return { withinMin, interval };\n  }).sort((a, b) => a.withinMin - b.withinMin); // ascending by threshold\n}\n\nconst results = [];\nfor (const [userId, row] of Object.entries(userMap)) {\n  const departure = DateTime.fromISO(row.departure_time);\n  const minUntilDeparture = departure.diff(now, 'minutes').minutes;\n\n  if (minUntilDeparture <= 0) continue; // already past departure\n\n  // Find matching tier (smallest threshold that is >= minUntilDeparture, else largest)\n  let interval = tiers[tiers.length - 1].interval; // default to tightest\n  for (let i = tiers.length - 1; i >= 0; i--) {\n    if (minUntilDeparture > tiers[i].withinMin) {\n      interval = tiers[i].interval;\n      break;\n    }\n  }\n\n  results.push({\n    json: {\n      user_id: userId,\n      ntfy_topic: row.ntfy_topic,\n      initial_interval: interval,\n      earliest_departure: row.departure_time,\n      minutes_until_departure: Math.round(minUntilDeparture)\n    }\n  });\n}\n\nif (results.length === 0) {\n  // No users need tracking today (all online events or no events)\n  return [{ json: { _no_tracking_needed: true } }];\n}\n\nreturn results;",
        "mode": "runOnceForAllItems"
      },
