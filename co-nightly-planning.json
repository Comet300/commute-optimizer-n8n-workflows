    {
      "name": "Detect Dynamic Origin",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "// Dynamic origin detection — prepare default origin from n8n Variables.\n// The subsequent Sheets read (Node 7a) + Code node (Node 7b) may override\n// with the user's actual location if they're travelling.\nconst user = $json;\nconst homeCoords = $vars.HOME_COORDS; // e.g. \"44.4268,26.1025\"\nconst [homeLat, homeLng] = homeCoords.split(',').map(Number);\n\nreturn {\n  json: {\n    ...user,\n    home_lat: homeLat,\n    home_lng: homeLng,\n    origin_coords: homeCoords,\n    origin_type: 'home'\n  }\n};",
        "mode": "runOnceForAllItems"
      },
      "id": "4c800d59-9c19-4578-9652-b7e7d2b1a782",
      "position": [
        910,
        520
      ]
    },
