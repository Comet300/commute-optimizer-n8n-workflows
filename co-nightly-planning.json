    {
      "name": "Build Morning Digest",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "const allRows = $input.all().map(i => i.json);\nconst user = $('Loop Users').item.json;\nconst origin = $('Check If Travelling').item.json;\nconst today = $now.toFormat('yyyy-MM-dd');\nconst events = allRows.filter(r => r.user_id === user.user_id && r.plan_date === today);\n\nlet digest = `Good morning ${user.full_name}!\n`;\ndigest += `Planning from: ${origin.origin_type === 'travel' ? 'current location (travel mode)' : 'home'}\n\n`;\n\nif (events.length === 0) {\n  digest += \"No events today — enjoy your free day!\";\n} else {\n  for (const evt of events) {\n    const prefix = evt.is_tentative ? '⚠ Tentative: ' : '';\n    if (evt.is_online) {\n      digest += `${prefix}💻 ${evt.title} at ${evt.start_time}\n`;\n    } else {\n      digest += `${prefix}🚗 ${evt.title} at ${evt.start_time}\n`;\n      digest += `   Depart by ${evt.departure_time} (${evt.commute_minutes} min, ${evt.commute_mode})\n`;\n      if (evt.clothing_advice) digest += `   👔 ${evt.clothing_advice}\n`;\n    }\n  }\n}\n\nreturn { json: { message: digest, ntfy_topic: user.ntfy_topic } };",
        "mode": "runOnceForAllItems"
      },
      "id": "adc18213-d2b3-4a2d-b0a1-b2c081b2b19f",
