    {
      "name": "Calculate Reminders + Build Row",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "// --- Required n8n Variables check ---\nconst requiredVars = ['HOME_COORDS', 'HOME_RADIUS_METERS', 'DRESS_REMINDER_INTERVALS'];\nconst missingVars = requiredVars.filter(k => !$vars[k]);\nif (missingVars.length) {\n  throw new Error(`Missing n8n Variables: ${missingVars.join(', ')}. Set them in Settings → Variables before activating workflows.`);\n}\n\n// Combine all data into a daily_plan row\nconst classified = $('Classify Event').item.json;\nconst departure = $('Calculate Departure').item.json;\nconst weather = $json; // output of Sub-WF B\nconst user = $('Loop Users').item.json;\nconst origin = $('Check If Travelling').item.json;\n\n// --- At-home initial state ---\n// Set at_home based on origin_type. WF4 will update this in real-time based on GPS\n// position throughout the day — no need to predict from event locations here.\nconst atHome = origin.origin_type === 'home';\n\n// --- Reminder times ---\nconst ALL_DRESS_INTERVALS = $vars.DRESS_REMINDER_INTERVALS.split(',').map(s => s.trim()).filter(Boolean).map(Number).filter(n => !isNaN(n)); // e.g. \"90,60,30,15\" → [90, 60, 30, 15]\n\n// Apply dress_cap: if event has [dress:N] or [N] tag, only use intervals ≤ N\nconst dressCap = classified.dress_cap || 0;\nconst DRESS_INTERVALS = dressCap > 0\n  ? ALL_DRESS_INTERVALS.filter(n => n <= dressCap)\n  : ALL_DRESS_INTERVALS;\nconst maxInterval = DRESS_INTERVALS.length > 0 ? Math.max(...DRESS_INTERVALS) : 0;\n\nconst depTime = new Date(departure.departure_time);\nconst fourAM = new Date(depTime);\nfourAM.setHours(4, 0, 0, 0);\n\n// remind_dressed = max(departure - max(filtered intervals), 04:00)\n// Stores the earliest dressed reminder time. WF3 expands the filtered intervals\n// into individual checks (e.g., remind_dressed_30, remind_dressed_15 for a [30] event).\n// These only fire if at_home == true (maintained by WF4 based on real GPS position).\nconst dressedEarliest = maxInterval > 0\n  ? new Date(depTime.getTime() - maxInterval * 60 * 1000)\n  : depTime; // no intervals → no early reminder\nconst remindDressed = dressedEarliest < fourAM ? fourAM : dressedEarliest;\n\n// State column guard: if this event already exists with a non-\"planned\" state,\n// preserve its current_state and state_version. This prevents WF1 re-runs\n// (e.g., WF7 catch-up) from overwriting WF4's mid-day state transitions.\nconst existingRows = $(\"Read Today's Existing Plan\").all().map(i => i.json);\nconst existingRow = existingRows.find(r => r.event_id === classified.event_id);\nconst preserveState = existingRow && existingRow.current_state\n  && existingRow.current_state !== 'planned';\n\nconst row = {\n  event_id: classified.event_id,\n  user_id: user.user_id,\n  title: classified.title,\n  start_time: classified.adjusted_start,\n  end_time: classified.adjusted_end,\n  location: classified.location,\n  location_coords: $('Extract Coordinates').item.json.location_coords,\n  is_online: false,\n  is_tentative: classified.is_tentative,\n  commute_mode: departure.commute_mode,\n  departure_time: departure.departure_time,\n  commute_minutes: departure.commute_minutes,\n  weather_worst: weather.weather_worst || '',\n  clothing_advice: weather.clothing_advice || '',\n  dress_cap: dressCap,\n  remind_dressed: remindDressed.toISOString(),\n  remind_60: new Date(depTime.getTime() - 60 * 60 * 1000).toISOString(),\n  remind_30: new Date(depTime.getTime() - 30 * 60 * 1000).toISOString(),\n  remind_15: new Date(depTime.getTime() - 15 * 60 * 1000).toISOString(),\n  remind_now: departure.departure_time,\n  plan_date: $now.toFormat('yyyy-MM-dd'),\n  origin_coords: origin.origin_coords,\n  origin_type: origin.origin_type,\n  ntfy_topic: user.ntfy_topic,\n  at_home: atHome\n};\n\nif (preserveState) {\n  // Row exists with active state transition — don't reset.\n  // Omit current_state and state_version so the upsert preserves existing values.\n  // (Unmapped columns are preserved by the native \"Append or Update Row\" operation.)\n} else {\n  row.current_state = 'planned';\n  row.state_version = 0;\n}\n\nreturn { json: row };",
        "mode": "runOnceForAllItems"
      },
