    {
      "name": "Find Stale Events",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "// Stale-state reconciliation: find events where current_state is NOT terminal\n// and end_time + 60 min has passed\nconst now = new Date();\nconst items = $input.all();\nconst staleEvents = [];\nconst cleanEvents = [];\n\nfor (const item of items) {\n  const row = item.json;\n  const endTime = new Date(row.end_time);\n  const sixtyMinAfterEnd = new Date(endTime.getTime() + 60 * 60 * 1000);\n  const terminalStates = ['arrived', 'cancelled', 'skipped', 'expired'];\n  const isTerminal = terminalStates.includes(row.current_state);\n\n  if (!isTerminal && now > sixtyMinAfterEnd) {\n    // Check cancel_requested_at — if user cancelled recently, honor that\n    let newState = 'expired';\n    if (row.cancel_requested_at) {\n      const cancelTime = new Date(row.cancel_requested_at);\n      const sixtyMinAgo = new Date(now.getTime() - 60 * 60 * 1000);\n      if (cancelTime > sixtyMinAgo) {\n        newState = 'cancelled';\n      }\n    }\n    staleEvents.push({\n      ...row,\n      new_state: newState,\n      new_state_version: (parseInt(row.state_version) || 0) + 1\n    });\n  }\n}\n\nreturn staleEvents.map(e => ({ json: e }));",
        "mode": "runOnceForAllItems"
      },
      "id": "02abc610-ff21-492d-8bcd-59ab3cb49f1e",
      "position": [
        690,
        300
      ]
    },
