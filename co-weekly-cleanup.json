      "parameters": {
        "jsCode": "\n// Find rows older than 90 days\nconst ninetyDaysAgo = new Date(Date.now() - 90 * 24 * 60 * 60 * 1000);\nconst items = $input.all();\nconst oldRows = [];\n\nfor (let i = 0; i < items.length; i++) {\n  const ts = new Date(items[i].json.timestamp);\n  if (ts < ninetyDaysAgo) {\n    // Google Sheets rows are 1-indexed, header is row 1, data starts at row 2\n    oldRows.push({ json: { row_number: i + 2, timestamp: items[i].json.timestamp } });\n  }\n}\n\n// Sort descending so we delete from bottom up (avoids row number shifts)\noldRows.sort((a, b) => b.json.row_number - a.json.row_number);\nreturn oldRows;\n",
        "mode": "runOnceForAllItems"
