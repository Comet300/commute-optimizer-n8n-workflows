        "jsCode": "\n// Find commute_history rows older than 90 days (stats already calculated)\nconst ninetyDaysAgo = new Date(Date.now() - 90 * 24 * 60 * 60 * 1000);\nconst items = $input.all();\nconst oldRows = [];\n\nfor (let i = 0; i < items.length; i++) {\n  const ts = new Date(items[i].json.timestamp);\n  if (ts < ninetyDaysAgo) {\n    oldRows.push({ json: { row_number: i + 2, timestamp: items[i].json.timestamp } });\n  }\n}\n\noldRows.sort((a, b) => b.json.row_number - a.json.row_number);\nreturn oldRows;\n",
