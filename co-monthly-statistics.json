    {
      "name": "Build Monthly Digest",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "\nconst stats = $json;\nconst modes = JSON.parse(stats.modes);\nconst modeList = Object.entries(modes).map(([m, c]) => `${m}: ${c}`).join(', ');\n\nconst digest = `📊 Monthly Commute Report\n\nTotal trips: ${stats.total_trips}\nOn-time rate: ${stats.on_time_pct}%\nAverage delay: ${stats.avg_delay_min} min\nModes: ${modeList}\n\nMaps API this month: ~${stats.api_calls_estimate} calls ($${stats.api_cost_estimate} of $200 credit used)\n${stats.api_warning}`;\n\nreturn { json: { ...stats, digest } };\n",
        "mode": "runOnceForAllItems"
      },
      "id": "dc48cd12-e52a-4520-a5e4-cfdfca2d32c7",
      "position": [
        1130,
        300
      ]
    },
