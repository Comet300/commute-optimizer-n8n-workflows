    {
      "name": "Calculate Monthly Stats",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "\n// Calculate statistics for last month\nconst now = new Date();\nconst lastMonth = new Date(now.getFullYear(), now.getMonth() - 1, 1);\nconst thisMonth = new Date(now.getFullYear(), now.getMonth(), 1);\nconst items = $input.all().map(i => i.json);\n\n// Filter to last month's entries\nconst monthData = items.filter(i => {\n  const ts = new Date(i.timestamp);\n  return ts >= lastMonth && ts < thisMonth;\n});\n\n// Group by user\nconst byUser = {};\nfor (const trip of monthData) {\n  if (!byUser[trip.user_id]) {\n    byUser[trip.user_id] = { trips: [], modes: {} };\n  }\n  byUser[trip.user_id].trips.push(trip);\n  const mode = trip.commute_mode || 'unknown';\n  byUser[trip.user_id].modes[mode] = (byUser[trip.user_id].modes[mode] || 0) + 1;\n}\n\n// Calculate stats per user\nconst results = [];\nfor (const [userId, data] of Object.entries(byUser)) {\n  const onTimeCount = data.trips.filter(t => t.arrived_on_time === 'TRUE' || t.arrived_on_time === true).length;\n  const totalTrips = data.trips.length;\n  const avgDelay = data.trips\n    .filter(t => t.arrival_delay_min)\n    .reduce((sum, t) => sum + parseFloat(t.arrival_delay_min), 0) / (totalTrips || 1);\n\n  // Estimate API calls (Distance Matrix + Geocoding)\n  const nonOnlineTrips = data.trips.filter(t => t.commute_mode !== 'none').length;\n  const dailyAvg = nonOnlineTrips / 30;\n  const distMatrixCalls = Math.round(dailyAvg * 3 * 30 + dailyAvg * 7 * 30); // WF1 + WF2\n  const geocodeCalls = Math.round(nonOnlineTrips * 1.2); // unique locations\n  const totalApiCalls = distMatrixCalls + geocodeCalls;\n  const estimatedCost = (totalApiCalls * 0.005).toFixed(2); // ~$0.005 per call average\n\n  results.push({\n    user_id: userId,\n    total_trips: totalTrips,\n    on_time_pct: totalTrips ? Math.round(onTimeCount / totalTrips * 100) : 0,\n    avg_delay_min: Math.round(avgDelay),\n    modes: JSON.stringify(data.modes),\n    api_calls_estimate: totalApiCalls,\n    api_cost_estimate: estimatedCost,\n    api_warning: totalApiCalls > 5000 ? '⚠ Approaching 12% of $200 free credit' : '✅ Well within free tier'\n  });\n}\n\nreturn results.map(r => ({ json: r }));\n",
        "mode": "runOnceForAllItems"
      },
      "id": "28db31e6-a753-4177-aa22-4c36c7e4675d",
      "position": [
        690,
        300
      ]
    },
