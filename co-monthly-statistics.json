    {
      "name": "Find Old Daily Plan Rows",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "\n// Find daily_plan rows older than 90 days\nconst ninetyDaysAgo = new Date(Date.now() - 90 * 24 * 60 * 60 * 1000);\nconst items = $input.all();\nconst oldRows = [];\n\nfor (let i = 0; i < items.length; i++) {\n  const planDate = new Date(items[i].json.plan_date);\n  if (planDate < ninetyDaysAgo) {\n    oldRows.push({ json: { row_number: i + 2, plan_date: items[i].json.plan_date } });\n  }\n}\n\n// Sort descending — delete from bottom up to avoid row number shifts\noldRows.sort((a, b) => b.json.row_number - a.json.row_number);\nreturn oldRows;\n",
        "mode": "runOnceForAllItems"
      },
