      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "parameters": {
        "method": "POST",
        "url": "=http://localhost:8080/reminders-{{ $json.user_id }}",
        "authentication": "predefinedCredentialType",
        "options": {},
        "nodeCredentialType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParametersUi": {
