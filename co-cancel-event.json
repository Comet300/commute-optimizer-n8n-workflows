    {
      "name": "Check State + Cancel",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "\nconst eventId = $('Cancel Event').item.json.body.event_id;\nconst userId = $('Cancel Event').item.json.body.user_id;\nconst rows = $input.all().map(i => i.json);\n\nconst event = rows.find(r => r.event_id === eventId && r.user_id === userId);\nif (!event) {\n  return { json: { reply: 'Event not found', do_update: false } };\n}\n\nconst terminalStates = ['cancelled', 'skipped', 'arrived', 'expired'];\nif (terminalStates.includes(event.current_state)) {\n  return { json: { reply: 'Already terminal: ' + event.current_state, do_update: false } };\n}\n\nreturn { json: {\n  event_id: eventId,\n  user_id: userId,\n  reply: 'Event cancelled',\n  do_update: true,\n  state_version: (parseInt(event.state_version) || 0) + 1,\n  ntfy_topic: event.ntfy_topic\n}};\n",
        "mode": "runOnceForAllItems"
      },
      "id": "30d310b7-97c9-41ba-ab5b-a2f3d38c472b",
      "position": [
        690,
        300
      ]
    },
    {
      "name": "Should Update?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": ""
          },
          "conditions": [
            {
              "leftValue": "={{ $json.do_update }}",
              "rightValue": "true",
              "operation": {
                "type": "string",
                "operation": "equals",
                "sameType": false
              }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "c0026683-e44b-4a45-95e8-33a4da6b9c59",
