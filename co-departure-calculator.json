      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "\n// Convert event_start to Unix timestamp for departure_time parameter\n// Google Maps expects seconds since epoch for future departure times\nconst eventStart = new Date($json.event_start);\nconst departureUnix = Math.floor(eventStart.getTime() / 1000);\n\nreturn { json: {\n  origin: $json.origin,\n  destination: $json.destination,\n  event_start: $json.event_start,\n  force_car_mode: $json.force_car_mode,\n  departure_time_unix: departureUnix\n}};\n",
        "mode": "runOnceForAllItems"
      },
      "id": "cada5fa5-1457-402e-be0e-807f711d3967",
      "position": [
        470,
        300
      ]
