    {
      "name": "Compare Modes + Calculate Departure",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "\n// Parse the three API responses — identify by transport_mode tag (not array index)\nconst items = $input.all();\n\nfunction parseResponse(item) {\n  const data = item.json;\n  // Defensive check: ensure response data structure exists\n  if (!data || !data.rows || !data.rows[0] || !data.rows[0].elements || !data.rows[0].elements[0]) {\n    return null;\n  }\n  if (data.status !== 'OK') return null;\n  const el = data.rows[0].elements[0];\n  if (!el || el.status !== 'OK' || !el.duration || !el.distance) return null;\n  return {\n    duration_sec: el.duration.value,\n    duration_text: el.duration.text,\n    distance_m: el.distance.value\n  };\n}\n\n// Find items by their transport_mode tag instead of relying on Merge ordering\nconst transitItem = items.find(i => i.json.transport_mode === 'transit');\nconst drivingItem = items.find(i => i.json.transport_mode === 'driving');\nconst walkingItem = items.find(i => i.json.transport_mode === 'walking');\n\nconst transit = transitItem ? parseResponse(transitItem) : null;\nconst driving = drivingItem ? parseResponse(drivingItem) : null;\nconst walking = walkingItem ? parseResponse(walkingItem) : null;\n\nconst eventStart = new Date($('Prepare API Params').item.json.event_start);\nconst forceCar = $('Prepare API Params').item.json.force_car_mode;\n\n// Walking: only consider if under 20 minutes\nconst walkingViable = walking && walking.duration_sec < 20 * 60;\n\n// Rideshare = driving + 10 min wait\nconst rideshare = driving ? { ...driving, duration_sec: driving.duration_sec + 10 * 60 } : null;\n\n// Select mode\nlet bestMode, bestDuration;\n\nif (forceCar) {\n  // Pick faster: driving vs rideshare (rideshare is always slower, so pick driving)\n  bestMode = 'driving';\n  bestDuration = driving ? driving.duration_sec : null;\n} else {\n  // Pick shortest: transit vs walking (if viable)\n  const options = [];\n  if (transit) options.push({ mode: 'transit', sec: transit.duration_sec });\n  if (walkingViable) options.push({ mode: 'walking', sec: walking.duration_sec });\n  if (driving) options.push({ mode: 'driving', sec: driving.duration_sec });\n\n  if (options.length === 0) {\n    return { json: { error: true, message: 'unable to determine commute time' } };\n  }\n\n  options.sort((a, b) => a.sec - b.sec);\n  bestMode = options[0].mode;\n  bestDuration = options[0].sec;\n}\n\nif (!bestDuration) {\n  return { json: { error: true, message: 'unable to determine commute time' } };\n}\n\n// Add buffers\nlet bufferMin;\nif (bestMode === 'driving' || bestMode === 'rideshare') {\n  bufferMin = 10 + 7 + 5; // 10 min parking + 7 min reliability + 5 min leaving\n} else {\n  bufferMin = 7 + 5; // 7 min reliability + 5 min leaving\n}\n\nconst totalMin = Math.round(bestDuration / 60) + bufferMin;\nconst departureTime = new Date(eventStart.getTime() - totalMin * 60 * 1000);\n\nreturn { json: {\n  error: false,\n  departure_time: departureTime.toISOString(),\n  commute_minutes: totalMin,\n  commute_mode: bestMode,\n  mode_comparison: {\n    transit: transit ? Math.round(transit.duration_sec / 60) + ' min' : 'unavailable',\n    driving: driving ? Math.round(driving.duration_sec / 60) + ' min' : 'unavailable',\n    walking: walking ? Math.round(walking.duration_sec / 60) + ' min' : 'unavailable'\n  }\n}};\n",
        "mode": "runOnceForAllItems"
      },
      "id": "6e42e8ce-7cdc-493c-9f7b-f6a2c3b59964",
      "position": [
        1130,
        520
      ]
