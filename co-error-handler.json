            "index": 0
          },
          {
            "node": "Alert via ntfy",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Log to Error Sheet": {
      "main": [
        [
          {
            "node": "Check If Both Failed",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Alert via ntfy": {
      "main": [
        [
          {
            "node": "Check If Both Failed",
            "type": "main",
            "index": 1
          }
        ]
      ]
    },
    "Check If Both Failed": {
      "main": [
        [
          {
            "node": "Both Failed?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Both Failed?": {
      "main": [
        [
          {
            "node": "Fallback to File",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  }
}
